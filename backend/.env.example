# ==========================================
# Rose Essence Backend Environment Template
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=production
CLIENT_URL=https://roseessence.ae

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/rose_essence

# JWT Authentication Secret
JWT_SECRET=your_production_jwt_secret_key_here

# Razorpay (Optional / Legacy)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==========================================
# Noon Payments Gateway Configuration
# Official SDK: @noonpayments/np-payment-session-sdk
# Gateway Documentation: https://docs.noonpayments.com
# ==========================================

# API Endpoint:
# Sandbox: https://api-test.noonpayments.com
# Production: https://api.noonpayments.com
NOON_PAYMENTS_API_ENDPOINT=https://api.noonpayments.com

# Merchant Credentials (obtained from Noon Payments Merchant Portal)
NOON_PAYMENTS_APPLICATION_ID=your_noon_application_id
NOON_PAYMENTS_AUTHORIZATION_KEY=your_noon_authorization_key
NOON_PAYMENTS_BUSINESS_IDENTIFIER=your_noon_business_identifier

# Payment Configuration
NOON_PAYMENTS_PAYMENT_CATEGORY=pay
NOON_PAYMENTS_CURRENCY=AED
NOON_PAYMENTS_PAYMENT_ACTION=SALE
NOON_PAYMENTS_RETURN_URL=https://roseessence.ae/payment/noon-return

# ==========================================
# Noon Payments Webhook V2 (JWS)
# Endpoint URL: https://roseessence.ae/api/payment/noon/webhook
# HTTP Method: POST
# Webhook Version: 2 (JWS HS256)
# ==========================================
# Generated in Noon Merchant Portal -> Payment Settings -> Webhooks (Version 2)
NOON_PAYMENTS_WEBHOOK_SECRET=your_noon_webhook_v2_secret_key
